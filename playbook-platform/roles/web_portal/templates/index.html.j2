<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ web_portal_title }}</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; background: linear-gradient(135deg, #0f172a, #1e293b); color: #e2e8f0; }
    .card { max-width: 720px; margin: 10vh auto; padding: 2rem; background: rgba(15, 23, 42, 0.85); border: 1px solid rgba(148, 163, 184, 0.2); border-radius: 18px; box-shadow: 0 24px 80px rgba(0,0,0,.35); }
    h1 { margin-top: 0; font-size: 2rem; }
    p { line-height: 1.6; }
    .meta { color: #94a3b8; font-size: .95rem; }
  </style>
</head>
<body>
  <main class="card">
    <h1>{{ web_portal_title }}</h1>
    <p>{{ web_portal_welcome }}</p>
    <p class="meta">Clientes PPPoE: {{ pppoe_clients_subnet }} | Management: {{ management_subnet }} | Radius Mgmt: {{ radius_mgmt_subnet }}</p>
  </main>
</body>
</html>
