{
  "Dhcp4": {
    "interfaces-config": {
      "interfaces": ["eth0"]
    },
    "valid-lifetime": 3600,
    "renew-timer": 900,
    "rebind-timer": 1800,
    "lease-database": {
      "type": "memfile",
      "persist": true,
      "name": "/var/lib/kea/kea-leases4.csv"
    },
    "subnet4": [
{% if dhcp_scopes is defined and dhcp_scopes | length > 0 %}
{% for scope in dhcp_scopes %}
      {
        "subnet": "{{ scope.subnet }}",
        "pools": [
          {
            "pool": "{{ scope.range_start }} - {{ scope.range_end }}"
          }
        ],
        "option-data": [
          {
            "name": "routers",
            "data": "{{ scope.router }}"
          },
          {
            "name": "domain-name-servers",
            "data": "{{ dhcp_dns_servers | join(',') }}"
          },
          {
            "name": "domain-name",
            "data": "{{ platform_domain }}"
          }
        ]
      }{% if not loop.last %},{% endif %}
{% endfor %}
{% else %}
      {
        "subnet": "{{ dhcp_subnet_cidr }}",
        "pools": [
          {
            "pool": "{{ dhcp_range_start }} - {{ dhcp_range_end }}"
          }
        ],
        "option-data": [
          {
            "name": "routers",
            "data": "{{ dhcp_router }}"
          },
          {
            "name": "domain-name-servers",
            "data": "{{ dhcp_dns_servers | join(',') }}"
          },
          {
            "name": "domain-name",
            "data": "{{ platform_domain }}"
          }
        ]
      }
{% endif %}
    ]
  }
}
