{
  "Dhcp4": {
    "interfaces-config": {
      "interfaces": ["eth0"]
    },
    "valid-lifetime": 3600,
    "renew-timer": 900,
    "rebind-timer": 1800,
    "lease-database": {
      "type": "memfile",
      "persist": true,
      "name": "/var/lib/kea/kea-leases4.csv"
    },
    "subnet4": [
      {
        "subnet": "{{ dhcp_subnet_cidr }}",
        "pools": [
          {
            "pool": "{{ dhcp_range_start }} - {{ dhcp_range_end }}"
          }
        ],
        "option-data": [
          {
            "name": "routers",
            "data": "{{ dhcp_router }}"
          },
          {
            "name": "domain-name-servers",
            "data": "{{ dhcp_dns_servers | join(',') }}"
          },
          {
            "name": "domain-name",
            "data": "{{ platform_domain }}"
          }
        ]
      }
    ]
  }
}
